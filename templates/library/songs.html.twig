<section id="songs-section" class="songs">
    <div class="songs-container">
        <table id="songs" class="list" aria-label="{{ 'songs'|trans }}">
            <thead>
                <tr>
                    <th class="col-add"></th>
                    <th class="col-track-number">#</th>
                    <th class="col-artist">{{ 'artist'|trans }}</th>
                    <th class="col-title">{{ 'title'|trans }}</th>
                    <th class="col-album">{{ 'album'|trans }}</th>
                    <th class="col-duration">{{ 'duration'|trans }}</th>
                    <th class="col-year">{{ 'year'|trans }}</th>
                    <th class="col-genre">{{ 'genre'|trans }}</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="mobile-button mobile-forward-button mobile-songs-to-playlist-button" role="button" tabindex="0" aria-label="Show playlist" title="Show playlist">
        <i class="icon-right-open" aria-hidden="true"></i>
    </div>
    <div class="mobile-button mobile-back-button mobile-songs-to-artists-button" role="button" tabindex="0" aria-label="Back to artists" title="Back to artists">
        <i class="icon-left-open" aria-hidden="true"></i>
    </div>
</section>
